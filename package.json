{
  "name": "contabilplus-web",
  "version": "3.49.9",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.nexa.erp",
    "productName": "Nexa ERP",
    "icon": "build/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "nexa-erp-netizen",
        "repo": "nexa-erp"
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Nexa-ERP-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexa ERP",
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "electron/nexa-voice-listener.ps1",
        "to": "nexa-voice-listener.ps1"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.16.1",
    "electron-updater": "^6.8.3",
    "react": "^19.2.6",
    "react-calendar": "^6.0.1",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
